# GROQ_API_KEY: Required for Groq Vision API calls on the backend.
GROQ_API_KEY="your_actual_groq_api_key"

# GROQ_VISION_MODEL: Optional supported Groq vision model override.
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# GEMINI_API_KEY: Optional AI Studio environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
